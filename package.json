{
  "name": "codex-background-lite",
  "version": "0.1.1",
  "type": "module",
  "description": "通过本机 CDP 为 Codex Desktop 应用背景图的独立 Windows 工具。",
  "author": "codex-background-lite contributors",
  "keywords": [
    "codex",
    "codex-desktop",
    "chrome-devtools-protocol",
    "electron",
    "theme",
    "background"
  ],
  "bin": {
    "codex-background-lite": "./src/cli.js"
  },
  "main": "src/desktop/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/killosky/codex-background-lite.git"
  },
  "bugs": {
    "url": "https://github.com/killosky/codex-background-lite/issues"
  },
  "homepage": "https://github.com/killosky/codex-background-lite#readme",
  "scripts": {
    "check": "node --check src/cli.js && node --check src/cdp.js && node --check src/config.js && node --check src/image.js && node --check src/state.js && node --check src/theme-script.js && node --check src/launcher.js && node --check src/desktop/main.js && node --check src/desktop/preload.cjs && node --check src/desktop/renderer.js && node --test",
    "desktop": "electron .",
    "dist:win": "set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/&& electron-builder --win nsis",
    "pack:win": "set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/&& electron-builder --win dir",
    "dry-run": "node src/cli.js dry-run",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "README.md",
    "README.en.md",
    "LICENSE",
    "SECURITY.md",
    "SECURITY.en.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.en.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "docs"
  ],
  "build": {
    "appId": "dev.codex-background-lite.app",
    "productName": "Codex Background Lite",
    "directories": {
      "output": "dist"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "README.en.md",
      "SECURITY.md",
      "SECURITY.en.md",
      "docs/**/*",
      "LICENSE"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Codex Background Lite"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "license": "MIT"
}
